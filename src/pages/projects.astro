---
import Base from "../layouts/Base.astro";
import { projects } from "../data/site";
---
<Base title="Projects — Himanshu Sardana" description="Selected open-source projects by Himanshu Sardana.">
<div class="hero">
<h1>Projects</h1>
<p>A curated slice of my <strong><a href="https://github.com/HimanshuSardana" style="color:#f5f5f5">100+ GitHub repos</a></strong> — systems, TUIs, devtools & web.</p>
</div>
<section class="block" style="padding-top:0">
<div class="proj-list">
{projects.map(p => (
<a class="proj-row" href={p.url} target="_blank" rel="noreferrer">
<div><h3>{p.name} <span>· {p.language}</span></h3><p>{p.description}</p></div>
<span class="meta">{p.tags.slice(0,3).join(" • ")}</span>
</a>
))}
</div>
</section>
</Base>
