---
import Base from "../layouts/Base.astro";
import { projects } from "../data/site";
---
<Base title="Projects — Himanshu Sardana" description="Open-source projects by Himanshu Sardana.">
<section>
<p class="kicker">~/projects</p>
<h1>Projects</h1>
<p class="lead">A curated slice of my <a href="https://github.com/HimanshuSardana" style="color:var(--accent)">100+ GitHub repos</a> — systems, TUIs, devtools & web.</p>
</section>
<section style="padding-top:0">
<div class="grid">
{projects.map(p => (
<a class="card" href={p.url} target="_blank" rel="noopener">
<div class="card-top"><span><span class="lang-dot"></span>{p.language}</span><span>↗</span></div>
<h3>{p.name}</h3><p>{p.description}</p>
<div class="tags">{p.tags.map(t => <span class="tag">{t}</span>)}</div>
</a>
))}
</div>
</section>
</Base>
