---
import Base from "../layouts/Base.astro";
import { projects, posts } from "../data/site";
const selected = projects.filter(p => p.featured);
---
<Base title="Himanshu Sardana">
<div class="hero">
<h1>Hi, I'm Himanshu 👋</h1>
<p>Hello, I'm a <strong>developer</strong> who lives in the terminal with over <strong>{new Date().getFullYear() - 2019} years</strong> of building things. I am currently working with <strong>Go and TypeScript</strong>. Outside of work I rice my Arch setup and read manga in the terminal.</p>
<div class="socials">
<a href="https://github.com/HimanshuSardana" target="_blank" rel="noreferrer">Github</a><span class="sep">/</span>
<a href="https://himanshu.co" target="_blank" rel="noreferrer">Website</a><span class="sep">/</span>
<a href="/about">About</a>
</div>
</div>

<section class="block">
<div class="block-head"><h2>Latest posts</h2><a href="/posts">See all posts</a></div>
<div class="post-grid">
{posts.slice(0,2).map(p => (
<a class="post-card" href={`/posts/${p.slug}`}>
<h3>{p.title}</h3>
<time>{p.date.split("-").reverse().join("/")}</time>
<p>{p.excerpt}</p>
</a>
))}
</div>
</section>

<section class="block">
<div class="block-head"><h2>Selected projects ({selected.length})</h2><a href="/projects">See all</a></div>
<div class="proj-list">
{selected.map(p => (
<a class="proj-row" href={p.url} target="_blank" rel="noreferrer">
<div><h3>{p.name}</h3><p>{p.description}</p></div>
<span class="meta">{p.tags.slice(0,3).join(" • ")}</span>
</a>
))}
</div>
</section>
</Base>
