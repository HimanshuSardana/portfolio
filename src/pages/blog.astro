---
import Base from "../layouts/Base.astro";
import { posts } from "../data/site";
---
<Base title="Blog — Himanshu Sardana" description="Notes on Go, TUIs, Neovim and systems programming.">
<section>
<p class="kicker">~/blog</p>
<h1>Blog</h1>
<p class="lead">Notes on Go, terminal UIs, Neovim and things I'm building.</p>
</section>
<section style="padding-top:0">
<div class="post-list">
{posts.map(p => (
<a class="post-row" href={`/blog/${p.slug}`}>
<div><h3>{p.title}</h3><p>{p.excerpt}</p>
<div class="tags" style="margin-top:.5rem">{p.tags.map(t => <span class="tag">{t}</span>)}</div></div>
<span class="date">{p.date}</span>
</a>
))}
</div>
</section>
</Base>
