---
import Base from "../layouts/Base.astro";
import { posts } from "../data/site";
---
<Base title="Posts — Himanshu Sardana" description="Notes on Go, TUIs, Neovim and systems programming.">
<div class="hero">
<h1>Posts</h1>
<p>Notes on <strong>Go</strong>, <strong>terminal UIs</strong>, <strong>Neovim</strong> and things I'm building.</p>
</div>
<section class="block" style="padding-top:0">
<div class="post-grid">
{posts.map(p => (
<a class="post-card" href={`/posts/${p.slug}`}>
<h3>{p.title}</h3>
<time>{p.date.split("-").reverse().join("/")}</time>
<p>{p.excerpt}</p>
</a>
))}
</div>
</section>
</Base>
