---
export interface Props { title: string; description?: string; }
const { title, description = "Himanshu Sardana — developer. Go, Python, TypeScript. TUIs, devtools, systems." } = Astro.props;
const path = Astro.url.pathname;
const active = (p: string) => path === p || path.startsWith(p + "/") ? "active" : "";
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>λ</text></svg>" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style is:global>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#0a0a0a;color:#a3a3a3;font-family:'Inter',system-ui,-apple-system,sans-serif;line-height:1.7;font-size:.95rem;-webkit-font-smoothing:antialiased}
a{color:inherit}
::selection{background:#f5f5f5;color:#0a0a0a}
.wrap{max-width:700px;margin:0 auto;padding:0 1.25rem}
header.top{display:flex;align-items:center;justify-content:space-between;padding:1.5rem 0;font-size:.85rem}
header.top a{text-decoration:none;color:#a3a3a3;transition:color .2s}
header.top a:hover{color:#f5f5f5}
header.top nav{display:flex;gap:1.25rem}
header.top nav a.active{color:#f5f5f5}
.hero{padding:2.5rem 0 1rem}
.hero h1{color:#f5f5f5;font-size:1.9rem;font-weight:600;letter-spacing:-.02em;margin-bottom:1.25rem}
.hero p{margin-bottom:1rem}
.hero strong{color:#f5f5f5;font-weight:600}
.socials{display:flex;align-items:center;gap:.6rem;font-size:.85rem;margin-top:1.25rem}
.socials a{text-decoration:none;cursor:pointer}
.socials a:hover{color:#f5f5f5}
.socials .sep{color:#525252}
section.block{padding:1.75rem 0}
.block-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem}
.block-head h2{color:#f5f5f5;font-size:1.05rem;font-weight:600}
.block-head a{font-size:.82rem;text-decoration:underline;text-decoration-style:dashed;text-underline-offset:6px}
.block-head a:hover{color:#f5f5f5}
.post-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
@media(max-width:560px){.post-grid{grid-template-columns:1fr}}
.post-card{display:flex;flex-direction:column;gap:.5rem;border:1px solid #404040;border-radius:8px;padding:1rem;text-decoration:none;transition:all .3s;cursor:pointer}
.post-card:hover{transform:translateY(-8px);border-color:#a3a3a3}
.post-card h3{color:#f5f5f5;font-size:.95rem;font-weight:600;line-height:1.4}
.post-card time{font-size:.75rem;color:#737373}
.post-card p{font-size:.83rem;line-height:1.6}
.proj-list{display:flex;flex-direction:column;gap:1rem}
.proj-row{display:flex;width:100%;flex-direction:column;justify-content:space-between;gap:.35rem;border:1px solid #404040;border-radius:8px;padding:1rem;text-decoration:none;transition:all .3s;cursor:pointer}
@media(min-width:640px){.proj-row{flex-direction:row;align-items:center}}
.proj-row:hover{transform:translateY(-8px);border-color:#a3a3a3}
.proj-row h3{color:#f5f5f5;font-size:.95rem;font-weight:600}
.proj-row h3 span{color:#737373;font-weight:400}
.proj-row .meta{font-size:.8rem;color:#737373;white-space:nowrap}
.proj-row p{font-size:.83rem}
.contact{padding:2rem 0 1rem}
.contact h2{color:#f5f5f5;font-size:1.05rem;font-weight:600;margin-bottom:.75rem}
.contact a.mail{text-decoration:none}
.contact a.mail:hover{color:#f5f5f5}
footer.site{border-top:1px solid #262626;margin-top:1rem;padding:1.25rem 0 2.5rem;font-size:.8rem;color:#737373}
footer.site .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:.5rem}
/* prose (post pages) */
.prose{padding:2rem 0}
.prose time{font-size:.8rem;color:#737373}
.prose h1{color:#f5f5f5;font-size:1.7rem;letter-spacing:-.02em;margin:.5rem 0 1rem;line-height:1.25}
.prose h2{color:#f5f5f5;font-size:1.15rem;margin:1.75em 0 .5em}
.prose p{margin:.9em 0}
.prose ul,.prose ol{margin:.8em 0 .8em 1.4em}
.prose li{margin:.3em 0}
.prose a{color:#f5f5f5}
.prose pre{background:#111;border:1px solid #262626;border-radius:8px;padding:1rem;overflow:auto;font-size:.82rem;line-height:1.6}
.prose code{font-family:ui-monospace,Menlo,monospace;font-size:.87em}
.prose :not(pre)>code{background:#1a1a1a;padding:.15em .4em;border-radius:6px;color:#f5f5f5}
.back{font-size:.85rem;text-decoration:underline;text-decoration-style:dashed;text-underline-offset:6px}
.back:hover{color:#f5f5f5}
</style>
</head>
<body>
<div class="wrap">
<header class="top">
<a href="https://github.com/HimanshuSardana">github.com/HimanshuSardana</a>
<nav>
<a href="/" class={active("/") === "active" && path === "/" ? "active" : ""}>Home</a>
<a href="/projects" class={active("/projects")}>Projects</a>
<a href="/posts" class={active("/posts")}>Posts</a>
<a href="/about" class={active("/about")}>About</a>
</nav>
</header>
<main><slot /></main>
<div class="contact">
<h2>Get in touch</h2>
<p>Ping me on <a class="mail" href="https://github.com/HimanshuSardana">GitHub @HimanshuSardana</a> or follow me via my social links.</p>
<div class="socials">
<a href="https://github.com/HimanshuSardana" target="_blank" rel="noreferrer">Github</a><span class="sep">/</span>
<a href="https://himanshu.co" target="_blank" rel="noreferrer">Website</a><span class="sep">/</span>
<a href="/posts">Blog</a>
</div>
</div>
</div>
<footer class="site"><div class="wrap">
<span>© {new Date().getFullYear()} Himanshu Sardana</span>
<span>arch btw</span>
</div></footer>
</body></html>
